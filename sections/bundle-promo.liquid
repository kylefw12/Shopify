<section class="split"><div class="split__media">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="900">{% else %}<div style="height:100%;background:#c9bcae;display:grid;place-items:center;font:clamp(2rem,6vw,6rem) var(--serif);color:#fff">3 for 2</div>{% endif %}</div><div class="split__content"><div class="eyebrow">A little more, together</div><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div><a class="button" href="{{ section.settings.link }}">{{ section.settings.label }}</a></div></section>
{% schema %}{"name":"Bundle promotion","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Choose any three. Pay for two."},{"type":"richtext","id":"text","label":"Text","default":"<p>Build a set of eligible pieces you will reach for every day. The automatic Shopify discount applies at checkout.</p>"},{"type":"text","id":"label","label":"Button label","default":"Build your bundle"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Bundle promotion"}]}{% endschema %}
