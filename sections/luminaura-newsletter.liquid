<section class="luminaura-section luminaura-newsletter"><div class="luminaura-section__inner"><span class="luminaura-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="luminaura-heading">{{ section.settings.heading }}</h2><div class="luminaura-copy" style="margin:1rem auto 0">{{ section.settings.text }}</div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="LuminauraEmail">Email address</label><div><input id="LuminauraEmail" type="email" name="contact[email]" required placeholder="Your email address"><button type="submit">Sign me up →</button></div>{% if form.posted_successfully? %}<p>Thank you — you are on the list.</p>{% endif %}{% endform %}</div></section>
{% schema %}
{"name":"Luminaura newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A note from us"},{"type":"text","id":"heading","label":"Heading","default":"A little more luminous."},{"type":"richtext","id":"text","label":"Text","default":"<p>New drops, quiet favourites, and special offers — sent occasionally.</p>"}],"presets":[{"name":"Luminaura newsletter"}]}
{% endschema %}
