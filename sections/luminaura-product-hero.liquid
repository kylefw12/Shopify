{%- liquid
  assign hero_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign hero_alt = hero_image.alt | default: section.settings.heading
-%}

<section class="la-arena-hero">
  <div class="la-arena-hero__media">
    {% if hero_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 1200 }}"
          >
        {% endif %}

        {{ hero_image
          | image_url: width: 2600
          | image_tag:
            widths: '900,1200,1600,2000,2600',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_alt
        }}
      </picture>
    {% else %}
      <img
        src="{{ 'luminaura-hero-placeholder.png' | asset_url }}"
        alt="Luminaura jewellery campaign"
        width="1600"
        height="1100"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <div class="la-arena-hero__shade" aria-hidden="true"></div>

  <div class="la-arena-hero__content">
    {% if section.settings.eyebrow != blank %}
      <span class="la-arena-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}

    <h1>{{ section.settings.heading }}</h1>

    {% if section.settings.text != blank %}
      <div class="la-arena-hero__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.primary_label != blank %}
      <a
        class="la-arena-hero__link"
        href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.primary_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}

.la-arena-hero {
  position: relative;
  min-height: clamp(620px, 82svh, 920px);
  overflow: hidden;
  background: #d7d0c7;
  color: #ffffff;
}

.la-arena-hero__media,
.la-arena-hero__media picture,
.la-arena-hero__media img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.la-arena-hero__media img {
  object-fit: cover;
  object-position: center;
}

.la-arena-hero__shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.03) 28%,
      rgba(0, 0, 0, 0.52) 100%
    );
}

.la-arena-hero__content {
  position: relative;
  z-index: 2;

  display: flex;
  min-height: inherit;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;

  width: min(100%, 1560px);
  margin: 0 auto;

  padding:
    clamp(34px, 5vw, 72px)
    max(22px, var(--page-margin));
}

.la-arena-hero__eyebrow {
  margin-bottom: 8px;

  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.la-arena-hero h1 {
  max-width: 12ch;
  margin: 0;

  color: inherit;

  font-family: var(--font-heading--family);
  font-size: clamp(3rem, 7.5vw, 8rem);
  font-weight: 500;

  letter-spacing: -0.035em;
  line-height: 0.88;

  text-wrap: balance;
}

.la-arena-hero__text {
  max-width: 40rem;
  margin-top: 18px;

  font-size: clamp(0.95rem, 1.2vw, 1.08rem);
  line-height: 1.5;
}

.la-arena-hero__text p {
  margin: 0;
}

.la-arena-hero__link {
  display: inline-block;

  margin-top: 22px;
  padding-bottom: 4px;

  border-bottom: 1px solid currentColor;

  color: inherit;

  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;

  text-decoration: none;
  text-transform: uppercase;

  transition: opacity 0.2s ease;
}

.la-arena-hero__link:hover {
  opacity: 0.68;
}

@media screen and (max-width: 749px) {

  .la-arena-hero {
    min-height: 76svh;
  }

  .la-arena-hero__content {
    padding: 28px 20px 34px;
  }

  .la-arena-hero h1 {
    max-width: 10ch;
    font-size: clamp(3.1rem, 14vw, 5.8rem);
  }

  .la-arena-hero__text {
    max-width: 31rem;
    margin-top: 14px;
    font-size: 0.92rem;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura campaign hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop campaign image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile campaign image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE EVERYDAY EDIT"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting copy",
      "default": "<p>Waterproof jewellery made to live in.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Link label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Luminaura campaign hero"
    }
  ]
}
{% endschema %}
