{%- liquid
  assign hero_image = section.settings.desktop_image
  assign fallback_product = section.settings.fallback_product
  if fallback_product == blank
    assign fallback_product = collections.all.products.first
  endif
  if hero_image == blank and fallback_product != blank
    assign hero_image = fallback_product.featured_media.preview_image
  endif
  assign hero_alt = hero_image.alt | default: section.settings.heading
-%}

<section class="ln-product-hero" {{ section.shopify_attributes }}>
  <div class="ln-product-hero__inner">
    <div class="ln-product-hero__copy">
      <p class="ln-product-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="ln-product-hero__text">{{ section.settings.text }}</div>
      <div class="ln-product-hero__actions">
        <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        <a class="button button-secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
      </div>
      <p class="ln-product-hero__bundle"><strong>Choose any 3 eligible pieces. Pay for 2.</strong><span>Discount applies automatically at checkout when configured in Shopify.</span></p>
    </div>

    <figure class="ln-product-hero__media">
      {% if hero_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1100 }}">{% endif %}
          {{ hero_image | image_url: width: 2200 | image_tag: widths: '750,1100,1500,1800,2200', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
        </picture>
      {% else %}
        <img src="{{ 'luminaura-hero-placeholder.png' | asset_url }}" alt="Gold-tone everyday jewellery arranged on warm stone" width="1122" height="1400" loading="eager" fetchpriority="high">
      {% endif %}
    </figure>
  </div>
</section>

{% stylesheet %}
  .ln-product-hero {
    background: #fbf9f5;
    color: #24201d;
  }

  .ln-product-hero__inner {
    display: grid;
    grid-template-columns: minmax(300px, .68fr) minmax(0, 1.12fr);
    width: min(100%, 1560px);
    min-height: clamp(530px, calc(100svh - var(--header-group-height)), 720px);
    margin: 0 auto;
  }

  .ln-product-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(42px, 7vw, 112px);
    background: #fbf9f5;
  }

  .ln-product-hero__eyebrow {
    margin: 0 0 14px;
    color: #8a6544;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .ln-product-hero h1 {
    max-width: 11.2em;
    margin: 0;
    color: #24201d;
    font-family: var(--font-heading--family);
    font-size: clamp(2.7rem, 4.8vw, 5.6rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1;
    text-wrap: balance;
  }

  .ln-product-hero__text {
    max-width: 39rem;
    margin-top: 20px;
    color: #625a53;
    font-size: clamp(.95rem, 1.15vw, 1.08rem);
    line-height: 1.55;
  }

  .ln-product-hero__text p { margin: 0; }
  .ln-product-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  .ln-product-hero__bundle {
    display: grid;
    gap: 3px;
    margin: 24px 0 0;
    color: #776a5e;
    font-size: .73rem;
    line-height: 1.45;
  }

  .ln-product-hero__bundle strong { color: #24201d; font-weight: 600; }

  .ln-product-hero__media {
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: #eee7de;
  }

  .ln-product-hero__media picture,
  .ln-product-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ln-product-hero__media img { object-fit: cover; object-position: center; }

  @media screen and (max-width: 749px) {
    .ln-product-hero__inner { grid-template-columns: 1fr; min-height: 0; }
    .ln-product-hero__media { order: -1; aspect-ratio: 4 / 5; min-height: 0; }
    .ln-product-hero__copy { padding: 30px 22px 38px; }
    .ln-product-hero h1 { max-width: 12em; font-size: clamp(2.55rem, 11.7vw, 4rem); }
    .ln-product-hero__actions { width: 100%; }
    .ln-product-hero__actions .button { flex: 1 1 190px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura product hero",
  "settings": [
    {"type":"image_picker","id":"desktop_image","label":"Desktop jewellery image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile jewellery image"},
    {"type":"product","id":"fallback_product","label":"Fallback product image","info":"Uses this product's media if a hero image is not selected."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WATERPROOF. CONSIDERED. YOURS."},
    {"type":"text","id":"heading","label":"Heading","default":"Jewellery for every day"},
    {"type":"richtext","id":"text","label":"Supporting copy","default":"<p>Modern waterproof jewellery designed for daily wear, easy gifting, and effortless layering.</p>"},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop jewellery"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Build your bundle"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"}
  ],
  "presets": [{"name":"Luminaura product hero"}]
}
{% endschema %}
