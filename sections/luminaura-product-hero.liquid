{%- liquid
  assign hero_image = section.settings.desktop_image
  assign fallback_product = section.settings.fallback_product
  if fallback_product == blank
    assign fallback_product = collections.all.products.first
  endif
  if hero_image == blank and fallback_product != blank
    assign hero_image = fallback_product.featured_media.preview_image
  endif
  assign hero_alt = hero_image.alt | default: section.settings.heading
-%}

<section class="luminaura-compact-hero" {{ section.shopify_attributes }}>
  <div class="luminaura-compact-hero__inner">
    <div class="luminaura-compact-hero__copy">
      <p class="luminaura-compact-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="luminaura-compact-hero__text">{{ section.settings.text }}</div>
      <div class="luminaura-compact-hero__actions">
        <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        <a class="button button-secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
      </div>
      <p class="luminaura-compact-hero__bundle">Choose any 3 eligible pieces. Pay for 2.</p>
    </div>

    <figure class="luminaura-compact-hero__media">
      {% if hero_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1100 }}">{% endif %}
          {{ hero_image | image_url: width: 2200 | image_tag: widths: '750,1100,1500,1800,2200', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
        </picture>
      {% else %}
        <img src="{{ 'luminaura-hero-placeholder.png' | asset_url }}" alt="Gold-tone everyday jewellery arranged on warm stone" width="1122" height="1400" loading="eager" fetchpriority="high">
      {% endif %}
    </figure>
  </div>
</section>

{% stylesheet %}
  .luminaura-compact-hero {
    background: #fbf9f5;
    color: #24201d;
  }

  .luminaura-compact-hero__inner {
    display: grid;
    grid-template-columns: minmax(300px, .72fr) minmax(0, 1.28fr);
    width: min(100%, 1560px);
    height: clamp(360px, 31vw, 440px);
    max-height: 440px;
    margin: 0 auto;
  }

  .luminaura-compact-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(24px, 3vw, 42px);
    background: #fbf9f5;
  }

  .luminaura-compact-hero__eyebrow {
    margin: 0 0 9px;
    color: #8a6544;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .luminaura-compact-hero h1 {
    max-width: 10.8em;
    margin: 0;
    color: #24201d;
    font-family: var(--font-heading--family);
    font-size: clamp(2.05rem, 3vw, 3.35rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-wrap: balance;
  }

  .luminaura-compact-hero__text {
    max-width: 32rem;
    margin-top: 12px;
    color: #625a53;
    font-size: clamp(.95rem, 1.15vw, 1.08rem);
    line-height: 1.55;
  }

  .luminaura-compact-hero__text p { margin: 0; }
  .luminaura-compact-hero__actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 17px; }

  .luminaura-compact-hero__bundle {
    margin: 14px 0 0;
    color: #625a53;
    font-size: .73rem;
    line-height: 1.45;
  }

  .luminaura-compact-hero__media {
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: #eee7de;
  }

  .luminaura-compact-hero__media picture,
  .luminaura-compact-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .luminaura-compact-hero__media img { object-fit: cover; object-position: center; }

  @media screen and (max-width: 749px) {
    .luminaura-compact-hero__inner { grid-template-columns: 1fr; height: auto; max-height: none; }
    .luminaura-compact-hero__media { order: -1; aspect-ratio: 4 / 3; min-height: 0; }
    .luminaura-compact-hero__copy { padding: 22px 20px 24px; }
    .luminaura-compact-hero h1 { max-width: 12em; font-size: clamp(2rem, 8vw, 2.7rem); }
    .luminaura-compact-hero__text { margin-top: 10px; font-size: .94rem; line-height: 1.48; }
    .luminaura-compact-hero__actions { width: 100%; margin-top: 16px; }
    .luminaura-compact-hero__actions .button { flex: 1 1 160px; }
    .luminaura-compact-hero__bundle { margin-top: 11px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura product hero",
  "settings": [
    {"type":"image_picker","id":"desktop_image","label":"Desktop jewellery image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile jewellery image"},
    {"type":"product","id":"fallback_product","label":"Fallback product image","info":"Uses this product's media if a hero image is not selected."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WATERPROOF. CONSIDERED. YOURS."},
    {"type":"text","id":"heading","label":"Heading","default":"Jewellery for every day"},
    {"type":"richtext","id":"text","label":"Supporting copy","default":"<p>Modern waterproof jewellery designed for daily wear, easy gifting, and effortless layering.</p>"},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop jewellery"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Build your bundle"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"}
  ],
  "presets": [{"name":"Luminaura product hero"}]
}
{% endschema %}
