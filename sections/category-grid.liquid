<section class="section-pad" style="padding-top:0"><div class="page-width"><div class="section-heading"><div><div class="eyebrow">Shop by mood</div><h2>Find your everyday piece</h2></div></div><div class="grid grid--4">{% for block in section.blocks %}<a class="category-tile" href="{{ block.settings.collection.url | default: '#' }}" {{ block.shopify_attributes }}>{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="700" height="770">{% else %}<div style="height:100%;background:#d8d0c5"></div>{% endif %}<span class="category-tile__label">{{ block.settings.title }}</span></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Category grid","max_blocks":4,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Necklaces"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"}]}],"presets":[{"name":"Category grid","blocks":[{"type":"category","settings":{"title":"Necklaces"}},{"type":"category","settings":{"title":"Earrings"}},{"type":"category","settings":{"title":"Bracelets"}},{"type":"category","settings":{"title":"Rings"}}]}]}{% endschema %}
