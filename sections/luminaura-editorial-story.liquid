<section class="luminaura-editorial" {{ section.shopify_attributes }}><div class="luminaura-editorial__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '750,1100,1600', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}{% else %}<div class="luminaura-media__placeholder">Your next campaign image</div>{% endif %}</div><div class="luminaura-editorial__content"><span class="luminaura-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="luminaura-heading">{{ section.settings.heading }}</h2><div class="luminaura-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></section>
{% schema %}
{"name":"Luminaura editorial story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Made for real life"},{"type":"text","id":"heading","label":"Heading","default":"Jewellery that keeps up."},{"type":"richtext","id":"text","label":"Text","default":"<p>From a fresh swim to a last-minute dinner plan, our pieces are made to be lived in — not saved for later.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Meet Luminaura"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Luminaura editorial story"}]}
{% endschema %}
