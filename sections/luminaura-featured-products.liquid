<section class="luminaura-section luminaura-featured">
  <div class="luminaura-section__inner">
    <header class="luminaura-featured__header">
      <div>
        <span class="luminaura-eyebrow">The Luminaura edit</span>
        <h2 class="luminaura-heading">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.collection != blank %}
        <a href="{{ section.settings.collection.url }}">View all</a>
      {% endif %}
    </header>

    <div class="luminaura-featured__grid">
      {% assign shown_products = 0 %}
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          {% assign shown_products = shown_products | plus: 1 %}
          <article class="luminaura-featured-card">
            <a href="{{ product.url }}">
              <div class="luminaura-featured-card__media">
                {% if product.featured_media != blank %}
                  {{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: product.title }}
                {% else %}
                  <div class="luminaura-product-placeholder"><span>{{ shop.name }}</span></div>
                {% endif %}
              </div>
              <div class="luminaura-featured-card__meta">
                <span>{{ product.title }}</span>
                <span>{{ product.price | money }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% endif %}

      {% assign missing_cards = section.settings.product_limit | minus: shown_products %}
      {% if missing_cards > 0 %}
        {% for index in (1..missing_cards) %}
          <article class="luminaura-featured-card luminaura-featured-card--placeholder">
            <div class="luminaura-featured-card__media">
              <div class="luminaura-product-placeholder"><span>Luminaura</span></div>
            </div>
            <div class="luminaura-featured-card__meta">
              <span>Product placeholder</span>
              <span>Coming soon</span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luminaura products",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Pieces to wear on repeat."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Products to show","min":4,"max":8,"step":1,"default":4}
  ],
  "presets": [{"name":"Luminaura products"}]
}
{% endschema %}
