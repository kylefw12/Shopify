{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
-%}

<section class="luminaura-section luminaura-featured" {{ section.shopify_attributes }}>
  <div class="luminaura-section__inner">
    <header class="luminaura-featured__header">
      <div>
        <span class="luminaura-eyebrow">The Luminaura edit</span>
        <h2 class="luminaura-heading">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}">View all</a>
    </header>

    <div class="luminaura-featured__grid">
      {% assign shown_products = 0 %}
      {% for product in featured_collection.products limit: section.settings.product_limit %}
          {% assign shown_products = shown_products | plus: 1 %}
          <article class="luminaura-featured-card">
            <a href="{{ product.url }}">
              <div class="luminaura-featured-card__media">
                {% if product.featured_media != blank %}
                  {{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 72vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
                  {% if product.media.size > 1 %}
                    {{ product.media[1].preview_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 72vw', loading: 'lazy', alt: product.title, class: 'luminaura-featured-card__hover-image' }}
                  {% endif %}
                {% else %}
                  <div class="luminaura-product-placeholder"><span>{{ shop.name }}</span></div>
                {% endif %}
                {% if product.compare_at_price > product.price %}<span class="luminaura-featured-card__badge">Sale</span>{% endif %}
              </div>
              <div class="luminaura-featured-card__meta">
                <span>{{ product.title }}</span>
                <span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</span>
              </div>
            </a>
            {% for product_option in product.options_with_values %}
              {% liquid
                assign option_name = product_option.name | downcase
                assign is_finish_option = false

                if option_name contains 'color' or option_name contains 'colour' or option_name contains 'metal' or option_name contains 'material' or option_name contains 'finish' or option_name contains 'acabado'
                  assign is_finish_option = true
                endif
              %}
              {% if is_finish_option == false %}
                {% continue %}
              {% endif %}

              <div class="luminaura-featured-card__swatches" aria-label="{{ product_option.name | escape }} options">
                {% assign option_key = 'option' | append: product_option.position %}
                {% for product_option_value in product_option.values %}
                  {% assign matching_variant = blank %}
                  {% for variant in product.variants %}
                    {% if variant[option_key] == product_option_value.name %}
                      {% assign matching_variant = variant %}
                      {% if variant.available %}{% break %}{% endif %}
                    {% endif %}
                  {% endfor %}

                  {% if matching_variant != blank and matching_variant.available %}
                    <a
                      class="luminaura-featured-card__swatch-link"
                      href="{{ product.url }}?variant={{ matching_variant.id }}"
                      aria-label="View {{ product.title | escape }} in {{ product_option_value.name | escape }}"
                      title="{{ product_option_value.name | escape }}"
                    >
                      {% render 'luminaura-finish-swatch', swatch: product_option_value.swatch, option_value: product_option_value.name, mode: 'unscaled' %}
                    </a>
                  {% else %}
                    <span
                      class="luminaura-featured-card__swatch-link luminaura-featured-card__swatch-link--unavailable"
                      aria-label="{{ product_option_value.name | escape }} unavailable"
                      title="{{ product_option_value.name | escape }} — unavailable"
                    >
                      {% render 'luminaura-finish-swatch', swatch: product_option_value.swatch, option_value: product_option_value.name, mode: 'unscaled' %}
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
              {% break %}
            {% endfor %}
          </article>
        {% endfor %}
      {% if shown_products == 0 and request.design_mode %}
        <article class="luminaura-featured-card luminaura-featured-card--placeholder">
          <div class="luminaura-featured-card__media"><div class="luminaura-product-placeholder"><span>Select a collection</span></div></div>
          <div class="luminaura-featured-card__meta"><span>Choose products in the Theme Editor</span></div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luminaura products",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Pieces to wear on repeat."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Products to show","min":4,"max":8,"step":1,"default":4}
  ],
  "presets": [{"name":"Luminaura products"}]
}
{% endschema %}
