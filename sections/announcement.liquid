<div class="announcement">{{ section.settings.text | replace: '{{ amount }}', section.settings.amount | escape }}</div>
{% schema %}{"name":"Announcement bar","settings":[{"type":"text","id":"text","label":"Message","default":"Complimentary shipping on orders over {{ amount }}"},{"type":"text","id":"amount","label":"Amount","default":"75"}],"presets":[{"name":"Announcement bar"}]}{% endschema %}
