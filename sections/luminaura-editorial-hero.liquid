<section class="luminaura-hero" {{ section.shopify_attributes }}>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'luminaura-hero__media', widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading }}
  {% else %}<div class="luminaura-hero__placeholder"></div>{% endif %}
  <div class="luminaura-hero__content"><span class="luminaura-eyebrow">{{ section.settings.eyebrow }}</span><h1 class="luminaura-heading">{{ section.settings.heading }}</h1><div class="luminaura-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}</div>
</section>
{% schema %}
{"name":"Luminaura editorial hero","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Waterproof jewellery for every day"},{"type":"text","id":"heading","label":"Heading","default":"A little brilliance, every day."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtful, water-resistant pieces made to become part of your everyday ritual.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Luminaura editorial hero"}]}
{% endschema %}
