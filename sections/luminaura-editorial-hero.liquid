{%- liquid
  assign hero_image = section.settings.image
  assign fallback_product = section.settings.fallback_product
  if fallback_product == blank
    assign fallback_product = collections.all.products.first
  endif
  if hero_image == blank and fallback_product != blank
    assign hero_image = fallback_product.featured_media.preview_image
  endif
  assign hero_alt = hero_image.alt | default: section.settings.heading
-%}

<section class="luminaura-hero" {{ section.shopify_attributes }}>
  <div class="luminaura-hero__content">
    <span class="luminaura-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="luminaura-heading">{{ section.settings.heading }}</h1>
    <div class="luminaura-copy">{{ section.settings.text }}</div>
    <div class="luminaura-hero__actions">
      <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      <a class="button button-secondary" href="{{ section.settings.secondary_button_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_button_label }}</a>
    </div>
    <p class="luminaura-hero__offer"><strong>Choose any 3 eligible pieces. Pay for 2.</strong><br>The automatic Shopify discount applies at checkout.</p>
  </div>

  <div class="luminaura-hero__visual">
    {% if hero_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{% endif %}
        {{ hero_image | image_url: width: 2200 | image_tag: class: 'luminaura-hero__media', widths: '750,1000,1400,1800,2200', sizes: '(min-width: 750px) 62vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
      </picture>
    {% else %}
      <div class="luminaura-hero__placeholder">
        <img src="{{ 'luminaura-hero-placeholder.png' | asset_url }}" alt="Gold-tone everyday jewellery arranged on warm stone" width="1122" height="1400" loading="eager" fetchpriority="high">
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name":"Luminaura jewellery hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Desktop jewellery image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile jewellery image"},
    {"type":"product","id":"fallback_product","label":"Use this product image when no hero image is selected","info":"Optional fallback using existing product media."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WATERPROOF. CONSIDERED. YOURS."},
    {"type":"text","id":"heading","label":"Heading","default":"Jewellery for every day"},
    {"type":"richtext","id":"text","label":"Supporting text","default":"<p>Modern waterproof jewellery designed for daily wear, easy gifting, and effortless layering.</p>"},
    {"type":"text","id":"button_label","label":"Primary button label","default":"Shop jewellery"},
    {"type":"url","id":"button_link","label":"Primary button link"},
    {"type":"text","id":"secondary_button_label","label":"Secondary button label","default":"Build your bundle"},
    {"type":"url","id":"secondary_button_link","label":"Secondary button link"}
  ],
  "presets":[{"name":"Luminaura jewellery hero"}]
}
{% endschema %}
