<div class="la-announcement">
  <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}">
    {{ section.settings.announcement_text }}
  </a>
</div>

<header class="la-header" data-luminaura-header {{ section.shopify_attributes }}>
  <div class="la-header__inner">

    <details class="la-header__mobile-menu">
      <summary aria-label="Open menu">
        <span></span>
        <span></span>
      </summary>

      <div class="la-header__mobile-panel">
        <nav aria-label="Mobile navigation">
          {% for link in section.settings.menu.links %}
            {% if link.links != blank %}
              <details class="la-header__mobile-menu-group">
                <summary>{{ link.title }}</summary>
                <div class="la-header__mobile-submenu">
                  <a class="la-header__mobile-view-all" href="{{ link.url }}">View all {{ link.title }}</a>
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                    {% for grandchild_link in child_link.links %}
                      <a class="la-header__mobile-submenu-link" href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                    {% endfor %}
                  {% endfor %}
                </div>
              </details>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          {% else %}
            <a href="{{ routes.all_products_collection_url }}">Shop</a>
            <a href="{{ routes.collections_url }}">Collections</a>
          {% endfor %}
        </nav>

        <div class="la-header__mobile-meta">
          <a href="{{ routes.search_url }}">Search</a>

          {% if shop.customer_accounts_enabled %}
            <a href="{{ routes.account_url }}">Account</a>
          {% endif %}
        </div>
      </div>
    </details>

    <nav class="la-header__nav" aria-label="Primary navigation">
      {% for link in section.settings.menu.links limit: 5 %}
        {% if link.links != blank %}
          <details class="la-header__menu-item">
            <summary>
              <span>{{ link.title }}</span>
              <span class="la-header__menu-caret" aria-hidden="true"></span>
            </summary>
            <div class="la-header__mega-menu">
              <div class="la-header__mega-menu-inner">
                <a class="la-header__mega-menu-title" href="{{ link.url }}">Shop all {{ link.title }}</a>
                <div class="la-header__mega-menu-grid">
                  {% for child_link in link.links %}
                    <div class="la-header__mega-menu-column">
                      {% if child_link.links != blank %}
                        <a class="la-header__mega-menu-heading" href="{{ child_link.url }}">{{ child_link.title }}</a>
                        <ul role="list">
                          {% for grandchild_link in child_link.links %}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% else %}
                        <a class="la-header__mega-menu-direct-link" href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endif %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.collections_url }}">Collections</a>
      {% endfor %}
    </nav>

    <a
      class="la-header__brand"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name }}"
    >
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: 360
          | image_tag:
            widths: '140,200,280,360',
            sizes: '180px',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        {{ section.settings.brand_name | default: shop.name }}
      {% endif %}
    </a>

    <div class="la-header__actions">

      {% if section.settings.show_localization %}
        {% form 'localization', class: 'la-header__localization' %}
          <select
            name="country_code"
            aria-label="Country or region"
            onchange="this.form.submit()"
          >
            {% for country in localization.available_countries %}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.currency.iso_code }}
              </option>
            {% endfor %}
          </select>
        {% endform %}
      {% endif %}

      <a class="la-header__search" href="{{ routes.search_url }}">
        Search
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="la-header__account" href="{{ routes.account_url }}">
          Account
        </a>
      {% endif %}

      <a class="la-header__bag" href="{{ routes.cart_url }}">
        Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
      </a>
    </div>

  </div>
</header>

<script src="{{ 'luminaura-header.js' | asset_url }}" type="module"></script>

{% stylesheet %}

#header-group {
  position: sticky;
  top: 0;
  z-index: 50;

  border: 0;
  background: #fbf9f5;

  backdrop-filter: none;
}

.la-announcement {
  display: grid;

  min-height: 30px;
  padding: 5px 18px;

  place-items: center;

  background: #24201d;
  color: #fffdf9;

  text-align: center;

  font-size: 0.63rem;
  font-weight: 600;
  letter-spacing: 0.045em;

  text-transform: uppercase;
}

.la-announcement a {
  color: inherit;
  text-decoration: none;
}

.la-header {
  position: relative;
  border-bottom: 1px solid #ded8cf;
  background: rgba(251, 249, 245, 0.98);
}

.la-header__inner {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto
    minmax(0, 1fr);

  align-items: center;

  min-height: 62px;

  width: min(100%, 1560px);
  margin: 0 auto;

  padding:
    0
    max(20px, var(--page-margin));
}

.la-header a {
  color: #24201d;
  text-decoration: none;
}

.la-header__nav,
.la-header__actions {
  display: flex;
  align-items: center;

  gap: clamp(14px, 1.7vw, 25px);
}

.la-header__menu-item {
  position: static;
}

.la-header__menu-item > summary {
  display: flex;
  align-items: center;
  gap: 7px;

  font: inherit;
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.03em;

  cursor: pointer;
  list-style: none;
}

.la-header__menu-item > summary::-webkit-details-marker,
.la-header__mobile-menu-group > summary::-webkit-details-marker {
  display: none;
}

.la-header__menu-caret {
  width: 6px;
  height: 6px;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
  transition: transform .2s ease;
}

.la-header__menu-item[open] .la-header__menu-caret {
  transform: rotate(225deg) translate(-2px, -1px);
}

.la-header__mega-menu {
  position: absolute;
  z-index: 55;
  top: 100%;
  left: 0;
  width: 100%;
  border-bottom: 1px solid #ded8cf;
  background: #fbf9f5;
  box-shadow: 0 24px 34px rgba(36, 32, 29, .08);
}

.la-header__mega-menu-inner {
  width: min(100%, 1560px);
  margin: 0 auto;
  padding: 34px max(20px, var(--page-margin)) 40px;
}

.la-header__mega-menu-title,
.la-header__mega-menu-heading,
.la-header__mega-menu-direct-link {
  display: inline-block;
}

.la-header__mega-menu-title {
  margin-bottom: 26px;
  color: #8a6544 !important;
  font-size: .65rem !important;
  font-weight: 600;
  letter-spacing: .12em !important;
  text-transform: uppercase;
}

.la-header__mega-menu-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px 48px;
  max-width: 1080px;
}

.la-header__mega-menu-column {
  min-width: 0;
}

.la-header__mega-menu-column ul {
  display: grid;
  gap: 12px;
  margin: 14px 0 0;
  padding: 0;
}

.la-header__mega-menu-heading,
.la-header__mega-menu-direct-link {
  font-size: .72rem !important;
  font-weight: 600;
  letter-spacing: .07em !important;
  text-transform: uppercase;
}

.la-header__mega-menu-column li a {
  color: #625a53 !important;
  font-size: .76rem !important;
  letter-spacing: .01em !important;
  text-transform: none;
}

.la-header__mega-menu-column a:hover,
.la-header__mega-menu-title:hover {
  color: #8a6544 !important;
}

.la-header__nav a,
.la-header__actions a,
.la-header__localization select {
  border: 0;

  background: transparent;
  color: #24201d;

  font: inherit;

  font-size: 0.68rem;
  font-weight: 500;

  letter-spacing: 0.03em;

  text-transform: none;
}

.la-header__brand {
  justify-self: center;

  font-family: var(--font-heading--family);

  font-size: clamp(1.15rem, 1.8vw, 1.6rem);
  font-weight: 500;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.la-header__brand img {
  display: block;

  width: auto;

  max-width: 190px;
  max-height: 36px;
}

.la-header__actions {
  justify-content: flex-end;
}

.la-header__localization select {
  max-width: 74px;
  padding: 2px 0;
}

.la-header__mobile-menu {
  display: none;
}

@media screen and (max-width: 749px) {

  .la-header__inner {
    grid-template-columns: 32px 1fr auto;

    min-height: 56px;

    padding-inline: 16px;
  }

  .la-header__nav,
  .la-header__search,
  .la-header__account,
  .la-header__localization {
    display: none;
  }

  .la-header__brand {
    justify-self: center;

    font-size: 1.15rem;
  }

  .la-header__bag {
    font-size: 0.65rem !important;
  }

  .la-header__mobile-menu {
    position: static;

    display: block;
  }

  .la-header__mobile-menu > summary {
    display: grid;

    width: 28px;
    height: 28px;

    cursor: pointer;

    list-style: none;

    place-content: center;

    gap: 5px;
  }

  .la-header__mobile-menu > summary::-webkit-details-marker {
    display: none;
  }

  .la-header__mobile-menu > summary span {
    display: block;

    width: 20px;
    height: 1px;

    background: #24201d;
  }

  .la-header__mobile-panel {
    position: absolute;

    z-index: 60;

    top: 100%;
    left: 0;

    width: 100%;
    min-height: calc(100svh - 86px);

    padding: 34px 20px 28px;

    border-top: 1px solid #ded8cf;

    background: #fbf9f5;
  }

  .la-header__mobile-panel nav {
    display: grid;

    gap: 4px;
  }

  .la-header__mobile-panel nav a {
    padding: 8px 0;

    font-family: var(--font-heading--family);

    font-size: clamp(2rem, 10vw, 3.8rem);

    line-height: 1;
  }

  .la-header__mobile-menu-group {
    border-bottom: 1px solid #ded8cf;
  }

  .la-header__mobile-menu-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    cursor: pointer;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 10vw, 3.8rem);
    line-height: 1;
    list-style: none;
  }

  .la-header__mobile-menu-group > summary::after {
    content: '+';
    font-family: var(--font-body--family);
    font-size: 1.3rem;
  }

  .la-header__mobile-menu-group[open] > summary::after {
    content: '−';
  }

  .la-header__mobile-submenu {
    display: grid;
    gap: 0;
    padding: 4px 0 18px;
  }

  .la-header__mobile-panel .la-header__mobile-submenu a {
    padding: 7px 0;
    font-family: var(--font-body--family);
    font-size: .84rem;
    line-height: 1.3;
  }

  .la-header__mobile-panel .la-header__mobile-view-all {
    margin-bottom: 7px;
    color: #8a6544;
    font-size: .68rem !important;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .la-header__mobile-panel .la-header__mobile-submenu-link {
    padding-left: 14px;
    color: #625a53;
  }

  .la-header__mobile-meta {
    display: flex;

    gap: 22px;

    margin-top: 36px;
    padding-top: 18px;

    border-top: 1px solid #ded8cf;
  }

  .la-header__mobile-meta a {
    font-size: 0.68rem;

    text-transform: uppercase;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "3X2 EN JOYAS · ENVÍO GRATIS +60€"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Luminaura"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country selector",
      "default": true
    }
  ]
}
{% endschema %}
