<div class="page-width bundle">
  <header class="bundle-header"><div class="eyebrow">The Luminaura edit</div><h1>Build your bundle</h1><div class="rte"><p>Choose any three eligible pieces and pay for two. Select your favourites below, then add them to your bag — Shopify’s automatic discount applies at checkout.</p></div></header>
  {% assign bundle_collection = section.settings.collection %}
  <div class="bundle-status"><div><strong data-bundle-status>0 of 3 selected</strong><div class="progress" style="width:min(70vw,420px)"><div class="progress__bar" data-bundle-progress style="width:0"></div></div></div><span class="eyebrow">3 for 2 · eligible pieces only</span></div>
  <div class="bundle-grid">
    {% for product in bundle_collection.products %}{% if product.tags contains '3 for 2' or product.tags contains 'bundle-eligible' %}
      <article class="product-card" data-bundle-product><a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: widths: '350,500,700', sizes: '50vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}<span class="badge">3 for 2</span></div><div class="product-card__info"><span class="product-card__title">{{ product.title }}</span><span class="product-card__price">{{ product.price | money }}</span></div></a><button class="button" style="width:100%;margin-top:12px" type="button" data-bundle-select>Add to bundle</button></article>
    {% endif %}{% endfor %}
  </div>
</div>
<script>document.addEventListener('DOMContentLoaded',()=>{const cards=[...document.querySelectorAll('[data-bundle-product]')];const status=document.querySelector('[data-bundle-status]');const bar=document.querySelector('[data-bundle-progress]');cards.forEach(card=>card.querySelector('[data-bundle-select]').addEventListener('click',()=>{const selected=document.querySelectorAll('[data-bundle-product].is-selected').length;if(card.classList.contains('is-selected')){card.classList.remove('is-selected');card.querySelector('button').textContent='Add to bundle'}else if(selected<3){card.classList.add('is-selected');card.querySelector('button').textContent='Selected ✓'}const count=document.querySelectorAll('[data-bundle-product].is-selected').length;status.textContent=count+' of 3 selected';bar.style.width=(count/3*100)+'%'}))});</script>
{% schema %}{"name":"Bundle builder","settings":[{"type":"collection","id":"collection","label":"Eligible products collection"}],"presets":[{"name":"Bundle builder"}]}{% endschema %}
