<section class="section-pad"><div class="page-width"><div class="section-heading"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">View collection →</a>{% endif %}</div><div class="grid grid--4">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The edit"},{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured products"}]}{% endschema %}
