{%- liquid
  assign bundle_collection = section.settings.collection
  if bundle_collection == blank
    assign bundle_collection = collections.all
  endif
-%}

<section class="luminaura-bundle-builder color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="luminaura-bundle-builder__inner">
    <div class="luminaura-bundle-builder__intro">
      <span class="luminaura-bundle-builder__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="button" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>
    </div>

    <div class="luminaura-bundle-builder__panel" data-luminaura-bundle-builder>
      <div class="luminaura-bundle-builder__steps" aria-label="Bundle progress">
        <span data-luminaura-step>1</span>
        <span data-luminaura-step>2</span>
        <span data-luminaura-step>Free</span>
      </div>
      <strong data-luminaura-bundle-status aria-live="polite">0 of 3 selected</strong>
      <p data-luminaura-bundle-helper aria-live="polite">Choose any 3 pieces. Maximum 1 free item per order.</p>
      <p class="luminaura-bundle-builder__feedback" data-luminaura-bundle-feedback aria-live="polite" hidden></p>
      <a class="button button-secondary" href="{{ section.settings.collection_link | default: '/collections/all' }}">Browse all jewellery</a>
      <button class="button" type="button" data-luminaura-bundle-submit disabled>Add my bundle to bag</button>
    </div>
  </div>
  <div class="luminaura-bundle-builder__products">
    {% for product in bundle_collection.products limit: 12 %}
          {% assign variant = product.selected_or_first_available_variant %}
          <article class="luminaura-bundle-builder__product{% unless variant.available %} is-sold-out{% endunless %}" data-luminaura-product-offer data-product-title="{{ product.title | escape }}" data-variant-id="{{ variant.id }}">
            <a href="{{ product.url }}" class="luminaura-bundle-builder__product-media">{% if product.featured_media != blank %}{{ product.featured_media.preview_image | image_url: width: 600 | image_tag: widths: '300,450,600', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: product.title }}{% else %}<span>{{ shop.name }}</span>{% endif %}</a>
            <div><a href="{{ product.url }}">{{ product.title }}</a><span>{{ product.price | money }}</span></div>
            <button type="button" class="button button-secondary" data-luminaura-add-bundle-item aria-pressed="false"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add to my bundle{% else %}Sold out{% endif %}</button>
          </article>
    {% endfor %}
    {% if bundle_collection.products_count == 0 and request.design_mode %}
      <article class="luminaura-bundle-builder__product luminaura-bundle-builder__product--placeholder">
        <div class="luminaura-bundle-builder__product-media"><span>Select eligible products</span></div>
        <div><span>Choose a collection in the Theme Editor</span></div>
        <button type="button" class="button button-secondary" disabled>Preview only</button>
      </article>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .luminaura-bundle-builder {
    padding: clamp(48px, 7vw, 88px) var(--padding-xl);
    background: #f8f5f0;
  }

  .luminaura-bundle-builder__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(28px, 5vw, 72px);
    max-width: var(--page-width);
    margin: 0 auto;
    align-items: center;
  }

  .luminaura-bundle-builder__intro {
    max-width: 720px;
  }

  .luminaura-bundle-builder__eyebrow,
  .luminaura-bundle-progress__eyebrow,
  .luminaura-product-offer__badge {
    display: inline-flex;
    width: fit-content;
    margin-block-end: 12px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #665a4c;
  }

  .luminaura-bundle-builder h2 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 4vw, 4.6rem);
    line-height: 1;
  }

  .luminaura-bundle-builder p {
    max-width: 58ch;
    margin: 0 0 24px;
    color: #5b5249;
  }

  .luminaura-bundle-builder__panel,
  .luminaura-product-offer,
  .luminaura-bundle-progress {
    border: 1px solid #ded5ca;
    border-radius: 2px;
    background: #fffdfa;
  }

  .luminaura-bundle-builder__panel {
    padding: clamp(24px, 4vw, 40px);
    box-shadow: 0 14px 32px rgb(61 46 32 / 0.07);
  }

  .luminaura-bundle-builder__panel .button + .button {
    margin-top: 10px;
  }

  .luminaura-bundle-builder__panel .button {
    min-height: 48px;
  }

  .luminaura-bundle-builder__panel [data-luminaura-bundle-status] {
    display: block;
    margin-block-end: 8px;
    color: #241f1a;
    font-size: 1rem;
    line-height: 1.35;
  }

  .luminaura-bundle-builder__panel [data-luminaura-bundle-helper] {
    margin-block-end: 16px;
    color: #5b5249;
  }

  .luminaura-bundle-builder__feedback {
    margin: -4px 0 16px;
    color: #2b6251;
    font-size: .88rem;
    line-height: 1.45;
  }

  .luminaura-bundle-builder__feedback.is-error { color: #9a3f32; }

  .luminaura-bundle-builder__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: var(--page-width);
    margin: 36px auto 0;
  }

  .luminaura-bundle-builder__product-media {
    display: grid;
    aspect-ratio: 4 / 5;
    place-items: center;
    overflow: hidden;
    background: #eee7dd;
    color: #665a4c;
    font-family: var(--font-heading--family);
  }

  .luminaura-bundle-builder__product-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 240ms ease; }
  .luminaura-bundle-builder__product:hover .luminaura-bundle-builder__product-media img { transform: scale(1.025); }
  .luminaura-bundle-builder__product > div:not(.luminaura-bundle-builder__product-media) { display: flex; justify-content: space-between; gap: 8px; padding: 10px 0; font-size: .84rem; }
  .luminaura-bundle-builder__product .button { width: 100%; }
  .luminaura-bundle-builder__product.is-sold-out { opacity: .58; }

  .luminaura-bundle-builder__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-block-end: 20px;
  }

  .luminaura-bundle-builder__steps span {
    display: grid;
    min-height: 56px;
    place-items: center;
    border: 1px solid #d8cec2;
    border-radius: 2px;
    background: #fbf9f6;
    color: #5b5249;
    font-weight: 600;
  }

  .luminaura-bundle-builder__steps span.is-active {
    border-color: #7a6549;
    background: #7a6549;
    color: #fffdfa;
  }

  @media screen and (max-width: 749px) {
    .luminaura-bundle-builder__inner {
      grid-template-columns: 1fr;
    }
    .luminaura-bundle-builder__products { grid-template-columns: repeat(2, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura bundle builder",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Eligible products collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited relaunch offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Jewellery Set"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Choose any 3 pieces from Luminaura and only pay for 2. Maximum 1 free item per order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build My Set"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "url",
      "id": "collection_link",
      "label": "Eligible collection link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Luminaura bundle builder"
    }
  ]
}
{% endschema %}
