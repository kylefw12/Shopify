<footer class="site-footer"><div class="page-width"><div class="footer-grid"><div><div class="brand">{{ shop.name }}</div><p class="rte" style="margin-top:15px;color:#bdb7ad">{{ section.settings.heading }}</p></div><div><h3>Explore</h3><div class="footer-links">{% for link in linklists[section.settings.menu_1].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div></div><div><h3>Service</h3><div class="footer-links"><a href="/pages/contact">Contact</a><a href="/pages/shipping-returns">Shipping & returns</a><a href="/pages/care-guide">Care guide</a></div></div><div><h3>Follow along</h3><div class="footer-links"><a href="#">Instagram</a><a href="#">Pinterest</a></div></div></div><div class="footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }} · Made for everyday.</div></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"heading","label":"Intro","default":"Jewellery for every day."},{"type":"link_list","id":"menu_1","label":"Explore menu","default":"footer"},{"type":"link_list","id":"menu_2","label":"Secondary menu","default":"main-menu"}],"presets":[{"name":"Footer"}]}{% endschema %}
