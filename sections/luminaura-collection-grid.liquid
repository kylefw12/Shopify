<section class="luminaura-section" {{ section.shopify_attributes }}>
  <div class="luminaura-section__inner">
    <header class="luminaura-collection-grid__header">
      <div>
        <span class="luminaura-eyebrow">Comprar por categoría</span>
      </div>
      <a href="{{ routes.collections_url }}">Explorar todas las colecciones</a>
    </header>

    <div class="luminaura-collection-grid">
      {% for block in section.blocks %}
        {% liquid
          assign category_handle = block.settings.collection.handle
          assign category_title = block.settings.title | downcase

          if category_handle == blank
            case category_title
              when 'necklaces'
                assign category_handle = 'collares'
              when 'earrings'
                assign category_handle = 'pendientes'
              when 'bracelets'
                assign category_handle = 'pulseras'
              when 'rings'
                assign category_handle = 'anillos'
            endcase
          endif

          assign category_url = block.settings.collection.url
          if category_url == blank and category_handle != blank
            assign category_url = '/collections/' | append: category_handle
          endif

          case category_handle
            when 'collares'
              assign category_image_asset = 'luminaura-category-necklaces.png'
            when 'pendientes'
              assign category_image_asset = 'luminaura-category-earrings.png'
            when 'pulseras'
              assign category_image_asset = 'luminaura-category-bracelets.png'
            when 'anillos'
              assign category_image_asset = 'luminaura-category-rings.png'
            else
              assign category_image_asset = blank
          endcase
        %}
        <a class="luminaura-collection-card" href="{{ category_url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.title }}
          {% elsif category_image_asset != blank %}
            <img src="{{ category_image_asset | asset_url }}" loading="lazy" width="1254" height="1254" alt="{{ block.settings.title | escape }}">
          {% elsif block.settings.collection.featured_image != blank %}
            {{ block.settings.collection.featured_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.collection.title }}
          {% else %}
            <div class="luminaura-collection-placeholder" aria-hidden="true">
              <span>{{ block.settings.title | default: block.settings.collection.title | default: 'Luminaura' }}</span>
            </div>
          {% endif %}
          <span class="luminaura-collection-card__title">{{ block.settings.title | default: block.settings.collection.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luminaura collection grid",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Override image"},
        {"type":"text","id":"title","label":"Display title","default":"Necklaces"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Luminaura collection grid",
      "blocks": [
        {"type":"collection","settings":{"title":"Necklaces"}},
        {"type":"collection","settings":{"title":"Earrings"}},
        {"type":"collection","settings":{"title":"Bracelets"}},
        {"type":"collection","settings":{"title":"Rings"}}
      ]
    }
  ]
}
{% endschema %}
