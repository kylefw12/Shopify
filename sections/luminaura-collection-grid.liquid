<section class="luminaura-section" {{ section.shopify_attributes }}>
  <div class="luminaura-section__inner">
    <header class="luminaura-collection-grid__header">
      <div>
        <span class="luminaura-eyebrow">Shop by category</span>
        <h2 class="luminaura-heading">Everyday, curated.</h2>
      </div>
      <a href="{{ routes.collections_url }}">Explore all collections</a>
    </header>

    <div class="luminaura-collection-grid">
      {% for block in section.blocks %}
        <a class="luminaura-collection-card" href="{{ block.settings.collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.title }}
          {% elsif block.settings.collection.featured_image != blank %}
            {{ block.settings.collection.featured_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.collection.title }}
          {% else %}
            <div class="luminaura-collection-placeholder" aria-hidden="true">
              <span>{{ block.settings.title | default: block.settings.collection.title | default: 'Luminaura' }}</span>
            </div>
          {% endif %}
          <span class="luminaura-collection-card__title">{{ block.settings.title | default: block.settings.collection.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luminaura collection grid",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Override image"},
        {"type":"text","id":"title","label":"Display title","default":"Necklaces"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Luminaura collection grid",
      "blocks": [
        {"type":"collection","settings":{"title":"Necklaces"}},
        {"type":"collection","settings":{"title":"Earrings"}},
        {"type":"collection","settings":{"title":"Bracelets"}},
        {"type":"collection","settings":{"title":"Rings"}}
      ]
    }
  ]
}
{% endschema %}
