<div class="page-width"><header class="collection-header"><div class="eyebrow">The collection</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header><div class="toolbar"><span>{{ collection.products_count }} pieces</span><form><label class="visually-hidden" for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()"><option value="manual">Featured</option><option value="price-ascending">Price: low to high</option><option value="price-descending">Price: high to low</option><option value="created-descending">Newest</option></select></form></div>{% paginate collection.products by 24 %}<div class="grid grid--4">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><h2>Nothing here yet</h2><p>Try another collection.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<div style="text-align:center;padding:45px 0">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %} <span style="margin:0 20px">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</div>{% endif %}{% endpaginate %}</div>
{% schema %}{"name":"Main collection","settings":[],"presets":[{"name":"Main collection"}]}{% endschema %}
