<section class="luminaura-collection-hero" {{ section.shopify_attributes }}>
  <div class="luminaura-collection-hero__inner">
    <div>
      <p class="luminaura-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="luminaura-heading">
        {% if collection.title != blank %}
          {{ collection.title }}
        {% else %}
          {{ section.settings.fallback_heading }}
        {% endif %}
      </h1>
    </div>

    <div class="luminaura-collection-hero__copy">
      {% if collection.description != blank %}
        {{ collection.description }}
      {% else %}
        <p>{{ section.settings.fallback_text }}</p>
      {% endif %}
      <p class="luminaura-collection-hero__bundle">{{ section.settings.bundle_text }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .luminaura-collection-hero {
    background: #fbf9f5;
    border-bottom: 1px solid var(--luminaura-line);
  }

  .luminaura-collection-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .7fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: clamp(1.35rem, 3vw, 2.75rem) max(1.25rem, var(--page-margin));
  }

  .luminaura-collection-hero .luminaura-eyebrow {
    margin: 0 0 .45rem;
    color: #8a6544;
    font-size: .64rem;
    letter-spacing: .08em;
  }

  .luminaura-collection-hero .luminaura-heading {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 3.6rem);
    line-height: .98;
  }

  .luminaura-collection-hero__copy {
    max-width: 46ch;
    color: color-mix(in srgb, var(--luminaura-ink) 72%, transparent);
    font-size: .9rem;
    line-height: 1.5;
  }

  .luminaura-collection-hero__copy p {
    margin: 0;
  }

  .luminaura-collection-hero__bundle {
    margin-top: .7rem !important;
    color: var(--luminaura-gold);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .03em;
    text-transform: none;
  }

  @media screen and (max-width: 749px) {
    .luminaura-collection-hero__inner {
      grid-template-columns: 1fr;
      gap: .7rem;
      padding-block: 1.25rem 1.35rem;
    }

    .luminaura-collection-hero .luminaura-heading {
      max-width: none;
      font-size: clamp(1.9rem, 9vw, 2.8rem);
    }

    .luminaura-collection-hero__copy {
      font-size: .84rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luminaura collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop Luminaura"
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Fallback heading",
      "default": "Everyday jewellery"
    },
    {
      "type": "textarea",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Waterproof pieces designed for daily wear, thoughtful gifting, and effortless layering."
    },
    {
      "type": "text",
      "id": "bundle_text",
      "label": "Bundle text",
      "default": "Choose any 3 eligible pieces. Pay for 2."
    }
  ],
  "presets": [
    {
      "name": "Luminaura collection"
    }
  ]
}
{% endschema %}
