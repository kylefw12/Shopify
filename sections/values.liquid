<section class="section-pad"><div class="page-width"><div class="value-list">{% for block in section.blocks %}<div class="value" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Brand values","max_blocks":4,"blocks":[{"type":"value","name":"Value","settings":[{"type":"text","id":"title","label":"Title","default":"Waterproof"},{"type":"textarea","id":"text","label":"Text","default":"Made to keep up with real life."}]}],"presets":[{"name":"Brand values","blocks":[{"type":"value","settings":{"title":"Waterproof","text":"Made to keep up with real life."}},{"type":"value","settings":{"title":"Everyday","text":"Easy pieces, endlessly wearable."}},{"type":"value","settings":{"title":"Giftable","text":"Thoughtful details for every someone."}},{"type":"value","settings":{"title":"Considered","text":"Quality materials, quietly refined."}}]}]}{% endschema %}
