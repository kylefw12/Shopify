<div class="page-width section-pad"><header style="text-align:center"><div class="eyebrow">Find your piece</div><h1>Search</h1><form class="search-form" action="{{ routes.search_url }}"><label class="visually-hidden" for="SearchInput">Search</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search jewellery"><button type="submit">Search →</button></form></header>{% if search.performed %}<div class="section-heading"><h2>{{ search.results_count }} results</h2></div><div class="grid grid--4">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</div>
{% schema %}{"name":"Main search","settings":[],"presets":[{"name":"Main search"}]}{% endschema %}
