<div class="page-width"><div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / {{ product.title }}</div><section class="product"><div class="product-gallery">{% for media in product.media %}<div class="product-gallery__item">{% if media.preview_image %}{{ media.preview_image | image_url: width: 1000 | image_tag: widths: '500,700,1000', sizes: '(min-width: 900px) 40vw, 50vw', loading: 'lazy', alt: media.alt | default: product.title }}{% endif %}</div>{% else %}<div class="product-gallery__item"><div style="height:100%;display:grid;place-items:center;background:#e6ded2;font:35px var(--serif)">{{ shop.name }}</div></div>{% endfor %}</div><div class="product-info"><div class="eyebrow">{{ product.type | default: 'Everyday jewellery' }}</div><h1>{{ product.title }}</h1><div class="product-price">{{ product.price | money }}</div>{% if product.tags contains '3 for 2' or product.tags contains 'bundle-eligible' %}<p style="margin-top:12px;color:var(--accent)">3 for 2 eligible · Choose three eligible pieces, pay for two.</p>{% endif %}<div class="product-form">{% form 'product', product %}{% unless product.has_only_default_variant %}<label class="field-label" for="Variant">Choose an option</label><select class="select" id="Variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label class="field-label" for="Quantity">Quantity</label><div class="quantity" data-quantity><button type="button" data-minus aria-label="Decrease quantity">−</button><input id="Quantity" name="quantity" value="1" min="1" type="number"><button type="button" data-plus aria-label="Increase quantity">+</button></div><button class="button" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}</div><div class="product-details"><details class="accordion" open><summary>Description</summary><div class="accordion__content rte">{{ product.description }}</div></details><details class="accordion"><summary>Materials & care</summary><div class="accordion__content">Waterproof everyday wear. Keep your piece looking its best by rinsing after salt or chlorine exposure and storing it dry.</div></details><details class="accordion"><summary>Shipping & returns</summary><div class="accordion__content">Complimentary shipping over the threshold shown above. Easy returns within 30 days.</div></details></div></div></section></div>
{% schema %}{"name":"Main product","settings":[],"presets":[{"name":"Main product"}]}{% endschema %}
