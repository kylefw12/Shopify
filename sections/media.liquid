<section class="section-pad"><div class="page-width"><div class="section-heading"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div></div>{% if section.settings.video != blank %}<video controls muted playsinline preload="metadata" poster="{{ section.settings.poster | image_url: width: 1600 }}" style="width:100%;max-height:650px;object-fit:cover"><source src="{{ section.settings.video }}" type="video/mp4"></video>{% elsif section.settings.gif != blank %}<img src="{{ section.settings.gif | image_url: width: 1600 }}" alt="{{ section.settings.alt | escape }}" loading="lazy" width="1600" height="700">{% else %}<div style="aspect-ratio:16/7;background:#ddd6cc;display:grid;place-items:center;color:var(--muted)">Optional video or GIF section — add media in the theme editor</div>{% endif %}</div></section>
{% schema %}{"name":"Future media","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In motion"},{"type":"text","id":"heading","label":"Heading","default":"See it in the everyday"},{"type":"url","id":"video","label":"Video URL (MP4)"},{"type":"image_picker","id":"gif","label":"GIF / fallback image"},{"type":"image_picker","id":"poster","label":"Video poster"},{"type":"text","id":"alt","label":"Media alt text","default":"Luminaura jewellery in motion"}],"presets":[{"name":"Future media"}]}{% endschema %}
