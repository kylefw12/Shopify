{% if section.settings.enabled %}<section class="luminaura-section"><div class="luminaura-section__inner"><span class="luminaura-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="luminaura-heading" style="margin-bottom:2rem">{{ section.settings.heading }}</h2><div class="luminaura-media__frame">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, image_size: '1600x' }}{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '750,1100,1800', sizes: '100vw', loading: 'lazy', alt: section.settings.alt }}{% else %}<div class="luminaura-media__placeholder">Future campaign film<br><small>Upload a Shopify-hosted video or image in the theme editor.</small></div>{% endif %}</div></div></section>{% endif %}
{% schema %}
{"name":"Luminaura video or GIF","settings":[{"type":"checkbox","id":"enabled","label":"Show section","default":false},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In motion"},{"type":"text","id":"heading","label":"Heading","default":"The everyday, in motion."},{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"image","label":"GIF or fallback image"},{"type":"text","id":"alt","label":"Image alt text","default":"Luminaura jewellery in motion"}],"presets":[{"name":"Luminaura video or GIF"}]}
{% endschema %}
