<header class="site-header"><div class="page-width header-inner"><button class="icon-button menu-toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false">☰</button><a class="brand" href="{{ routes.root_url }}">{{ section.settings.logo_text | escape }}</a><nav class="nav" aria-label="Main navigation">{% for link in linklists[section.settings.menu].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><div class="header-actions"><a class="icon-button account-link" href="{{ routes.account_url }}" aria-label="Account">♙</a><a class="icon-button" href="{{ routes.search_url }}" aria-label="Search">⌕</a><a class="icon-button" href="{{ routes.cart_url }}" aria-label="Cart">Bag ({{ cart.item_count }})</a></div></div></header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"logo_text","label":"Logo text","default":"LUMINAURA"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}],"presets":[{"name":"Header"}]}{% endschema %}
