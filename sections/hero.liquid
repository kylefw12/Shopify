<section class="hero">{% if section.settings.image != blank %}<img class="hero__image" src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" width="2200" height="1400">{% else %}<div class="hero__image" style="background:#5c554d"></div>{% endif %}<div class="hero__overlay"></div><div class="page-width hero__content"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><div class="rte">{{ section.settings.text }}</div><div class="hero__actions"><a class="button button--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% if section.settings.secondary_label != blank %}<a class="button" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}</div></div></section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Waterproof · considered · yours"},{"type":"text","id":"heading","label":"Heading","default":"Small things. Beautifully made."},{"type":"richtext","id":"text","label":"Text","default":"<p>Modern jewellery designed to move with you, from first coffee to last light.</p>"},{"type":"text","id":"button_label","label":"Primary label","default":"Shop all jewellery"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"Build your bundle"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"Editorial hero"}]}{% endschema %}
