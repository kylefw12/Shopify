<div class="page-width"><div class="collection-header"><div class="eyebrow">Your edit</div><h1>Cart</h1></div>{% if cart.item_count > 0 %}<div class="cart-layout"><div>{% assign eligible_count = 0 %}{% for item in cart.items %}{% if item.product.tags contains '3 for 2' or item.product.tags contains 'bundle-eligible' %}{% assign eligible_count = eligible_count | plus: item.quantity %}{% endif %}<div class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: alt: item.title }}</a><div><a href="{{ item.url }}">{{ item.product.title }}</a><p style="color:var(--muted);font-size:13px">{{ item.variant.title }}</p><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size:11px;text-transform:uppercase;letter-spacing:.1em">Remove</a></div><div class="cart-line__price">{{ item.final_line_price | money }}</div></div>{% endfor %}</div><aside class="cart-summary"><h3>Bundle status</h3><p style="margin-top:10px">{% if eligible_count == 0 %}Add eligible pieces to unlock 3 for 2.{% elsif eligible_count < 3 %}Add {{ 3 | minus: eligible_count }} more eligible item{% if 3 | minus: eligible_count > 1 %}s{% endif %} to complete your bundle.{% else %}Bundle complete — your automatic discount will apply at checkout.{% endif %}</p><div class="progress"><div class="progress__bar" style="width:{{ eligible_count | at_most: 3 | times: 33.333 }}%"></div></div><div class="cart-summary__row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><form action="{{ routes.cart_url }}" method="post"><button class="button" name="checkout">Checkout</button></form><a class="button" style="width:100%;margin-top:10px;background:transparent;color:var(--ink)" href="{{ routes.all_products_collection_url }}">Continue shopping</a></aside></div>{% else %}<div class="empty-state"><h2>Your bag is waiting.</h2><p class="rte" style="margin:15px auto 25px">Find something small and beautiful to take with you.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop jewellery</a></div>{% endif %}</div>
{% schema %}{"name":"Main cart","settings":[],"presets":[{"name":"Main cart"}]}{% endschema %}
