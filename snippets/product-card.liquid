<article class="product-card"><a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="826">{% else %}<div style="height:100%;display:grid;place-items:center;color:var(--muted);font-family:var(--serif);font-size:24px">{{ shop.name }}</div>{% endif %}{% if product.tags contains '3 for 2' or product.tags contains 'bundle-eligible' %}<span class="badge">3 for 2 eligible</span>{% endif %}</div><div class="product-card__info"><span class="product-card__title">{{ product.title }}</span><span class="product-card__price">{{ product.price | money }}</span></div></a></article>
