<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {{ content_for_header }}
    {{ 'luminaura.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    <script src="{{ 'luminaura.js' | asset_url }}" defer></script>
  </body>
</html>
